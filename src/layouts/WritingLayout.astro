---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { formatDate, readingTime } from "@/lib/writing";

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  tags?: string[];
  content?: string;
}

const { title, description, publishedAt, updatedAt, tags = [], content = "" } = Astro.props;
const minutes = readingTime(content);
---

<BaseLayout title={title} description={description}>
  <article class="article-shell">
    <header class="article-header">
      <p class="eyebrow">Field note</p>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      <div class="article-meta">
        <time datetime={publishedAt.toISOString()}>{formatDate(publishedAt)}</time>
        <span>{minutes} min read</span>
        {updatedAt && <span>Updated {formatDate(updatedAt)}</span>}
      </div>
      {tags.length > 0 && (
        <div class="tag-list" aria-label="Tags">
          {tags.map((tag) => <span>{tag}</span>)}
        </div>
      )}
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</BaseLayout>

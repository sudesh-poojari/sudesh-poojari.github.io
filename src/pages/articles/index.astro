---
import WritingList from "@/components/WritingList.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { byPublishedDate, isPublished } from "@/lib/writing";
import { getCollection } from "astro:content";

const articles = (await getCollection("articles")).filter(isPublished).sort(byPublishedDate);
---

<BaseLayout title="Articles" description="Long-form technical essays from Sudesh Poojari.">
  <header class="page-title">
    <p class="eyebrow">Field Notes</p>
    <h1>Articles</h1>
    <p>Longer essays on frontend architecture, performance, accessibility, and reliability.</p>
  </header>
  <section class="section">
    {articles.length > 0 ? <WritingList entries={articles} /> : (
      <div class="empty-state">
        <h2>Coming soon</h2>
        <p>Long-form technical essays are being drafted and reviewed before publication.</p>
      </div>
    )}
  </section>
</BaseLayout>
